---
import Base from "../../layouts/Base.astro";
import { KNOWLEDGE_VERSION, PUBLIC_KNOWLEDGE } from "../../lib/public-knowledge.ts";
---
<Base
  title="Diagnóstico y retiro de bicicletas en Vitacura | Vector Bikes"
  description="Diagnóstico y cotización en el taller Vector Bikes. Retiro y devolución por $15.000 en Vitacura y Las Condes. Dirección, horarios de recepción y contacto."
  path="/servicios"
  bookingEnabled={false}
  bookingEnabled={false}
>
  <section class="section" data-knowledge-version={KNOWLEDGE_VERSION}>
    <div class="wrap">
      <span class="label">Vector Bikes · Vitacura</span>
      <h1>Diagnóstico y retiro de bicicletas.</h1>
      {PUBLIC_KNOWLEDGE.items.map((item) => (
        <section>
          <h2>{item.title}</h2>
          {item.content.split(/\n\s*\n/).map((paragraph) => <p>{paragraph}</p>)}
        </section>
      ))}
      <p><a href="/geo/">Información publicada y fuentes</a> · <a href="/">Volver a Vector Bikes</a></p>
    </div>
  </section>
</Base>
