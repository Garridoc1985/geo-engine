# Variables de entorno: exportarlas en bash antes de iniciar.
GEO_HOST=127.0.0.1
GEO_PORT=8000
DATABASE_URL=postgresql:///geo_engine
# Modelos y credenciales opcionales para ejecución del router. No hay modelo por defecto.
# Dejarlos vacíos mantiene cada proveedor deshabilitado. No pegar claves en este archivo.
CLAUDE_MODEL=
ANTHROPIC_API_KEY=
OPENAI_MODEL=
OPENAI_API_KEY=
